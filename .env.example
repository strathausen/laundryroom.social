# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.
#
# This file is committed to version control, so never put real secrets in it.
# If you are cloning this repo, copy it to `.env` and fill in your own values:
#
#   cp .env.example .env
#
# Env schemas live in apps/nextjs/src/env.ts, packages/auth/env.ts and
# packages/email/src/env.ts. They validate at startup and fail loudly when a
# required variable is missing (validation is skipped when CI=1 or during lint).

# --- database (required) ------------------------------------------------------
# Postgres connection string, read by @vercel/postgres (packages/db) and by
# drizzle-kit (packages/db/drizzle.config.ts). On Supabase, use the transaction
# pooler url on port 6543; `pnpm db:push` swaps it for the direct port 5432.
POSTGRES_URL="postgres://postgres.[USERNAME]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?workaround=supabase-pooler.vercel"

# --- auth (required) ----------------------------------------------------------
# Secret used to sign/encrypt session cookies. Optional in development,
# required in production. Generate one with: openssl rand -base64 32
# @see https://authjs.dev/reference/core#secret
AUTH_SECRET='supersecret'

# Google OAuth - the main login provider (packages/auth/src/config.ts).
# @see https://authjs.dev/getting-started/providers/google
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''

# Discord OAuth. The provider is currently commented out in
# packages/auth/src/config.ts, but packages/auth/env.ts still requires both
# values to be non-empty and apps/auth-proxy uses them. Any placeholder works
# locally as long as the provider stays disabled.
AUTH_DISCORD_ID='unused'
AUTH_DISCORD_SECRET='unused'

# In case you're using the Auth Proxy (apps/auth-proxy) for preview deployments.
# Only set this for preview / local environments, never for production.
# AUTH_REDIRECT_PROXY_URL='https://auth.your-server.com/r'

# --- email (required) ---------------------------------------------------------
# Resend api key. Used for magic-link login (packages/auth) and for
# transactional emails like meetup invitations (packages/email).
# @see https://resend.com/api-keys
RESEND_KEY=''

# --- llm (required) -----------------------------------------------------------
# OpenAI credentials for packages/llm (content moderation and search text
# generation). The openai client is created at import time and the group /
# comment / discussion routers import it, so the api does not start when the
# variable is unset. An empty string slips past that check and only fails at
# the first llm call, so leave the line commented out until you have a key.
# Org and project ids are optional and only matter if your key belongs to several.
# OPENAI_API_KEY=''
# OPENAI_ORG_ID=''
# OPENAI_PROJECT_ID=''

# --- file uploads (required for image uploads) --------------------------------
# Vercel Blob read/write token, read implicitly by @vercel/blob in
# apps/nextjs/src/app/api/upload/route.ts. Without it, group and profile image
# uploads fail; everything else keeps working.
# @see https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=''

# --- misc (optional) ----------------------------------------------------------
# Port the Next.js dev server listens on. The tRPC client uses it to build the
# local base url (apps/nextjs/src/trpc/react.tsx). Defaults to 3000.
# PORT=3000
#
# VERCEL / VERCEL_ENV / VERCEL_URL are injected by Vercel and not needed locally.
