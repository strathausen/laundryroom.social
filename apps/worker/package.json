{
  "name": "@laundryroom/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts src/backfill-group-accounts.ts src/recover-group-credential.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs --external:pg-native --external:sharp --sourcemap --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "backfill-group-accounts": "pnpm with-env tsx src/backfill-group-accounts.ts",
    "recover-group-credential": "pnpm with-env tsx src/recover-group-credential.ts",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "pnpm with-env tsx watch src/index.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@laundryroom/group-accounts": "workspace:*",
    "@laundryroom/jobs": "workspace:*",
    "@t3-oss/env-core": "^0.10.1",
    "pg-boss": "^12.36.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@laundryroom/eslint-config": "workspace:*",
    "@laundryroom/prettier-config": "workspace:*",
    "@laundryroom/tsconfig": "workspace:*",
    "@types/node": "^22.20.2",
    "dotenv-cli": "^7.4.2",
    "esbuild": "0.28.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  },
  "prettier": "@laundryroom/prettier-config"
}
